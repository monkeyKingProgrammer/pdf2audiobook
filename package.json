{
  "name": "sonora-pdf-audiobook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.1",
    "@vitejs/plugin-react": "latest",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "lucide-react": "^0.544.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
